# Copy to .env in this folder (Homeworks/5/) and fill in real values. Never commit .env.
#   cp .env.example .env

# Required: Portkey gateway key. All five agents use gpt-6-luna through Portkey.
PORTKEY_API_KEY=your_portkey_key

# ---- Optional overrides (defaults shown) ----
# PORTKEY_PROVIDER=@azure-openai-global
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Loop and token limits
# MAX_DELEGATION_DEPTH=2
# MAX_DELEGATIONS_PER_RUN=8
# TEAM_TOKEN_BUDGET=300000
# BOSS_REQUEST_LIMIT=12
# BOSS_TOOL_CALLS_LIMIT=15
# BOSS_TOTAL_TOKENS_LIMIT=100000
# SPECIALIST_REQUEST_LIMIT=8
# SPECIALIST_TOOL_CALLS_LIMIT=10
# SPECIALIST_TOTAL_TOKENS_LIMIT=60000

# File locations (defaults: data/campus_customs_new.db via the MCP server, output/audit_trail.json)
# CAMPUS_CUSTOMS_DB=
# AUDIT_PATH=
